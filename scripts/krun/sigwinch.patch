+
+/// Forward host terminal resizes to the guest console on macOS, where the
+/// Linux signal-handler module is not built.
+#[cfg(target_os = "macos")]
+mod macos_sigwinch {
+    use std::os::unix::io::RawFd;
+    use std::sync::atomic::{AtomicI32, Ordering};
+
+    static FD: AtomicI32 = AtomicI32::new(-1);
+
+    extern "C" fn handler(_: libc::c_int) {
+        let val: u64 = 1;
+        let fd = FD.load(Ordering::Relaxed);
+        // Async-signal-safe: a single write to a non-blocking pipe.
+        let _ = unsafe { libc::write(fd, &val as *const u64 as *const libc::c_void, 8) };
+    }
+
+    pub fn register(fd: RawFd) {
+        FD.store(fd, Ordering::Relaxed);
+        unsafe {
+            let mut action: libc::sigaction = std::mem::zeroed();
+            action.sa_sigaction = handler as *const () as usize;
+            action.sa_flags = libc::SA_RESTART;
+            libc::sigaction(libc::SIGWINCH, &action, std::ptr::null_mut());
+        }
+    }
+}
